# AN758x PonWrt 单机型精简配置（diffconfig）—— 使用前必须 make defconfig 展开
# profile      : h3c_hm2004-du
# 机型         : H3C HM2004-DU（FTTR 主网关）
# SoC          : AN7581（EN7581）
# 光器件       : Airoha EN7572（UX3326 BOSA，i2c0 @0x50）
# 网口 PHY     : EN8811H（2.5G，lan1）+ 3×内置 GE（lan2/3/4）
# 无线         : MT7916（MT7916AN + MT7976DN，DBDC 2.4G 2x2 + 5G 2x2 160MHz）
# USB          : 1×USB2.0
# 校准/身份数据: reservearea（原厂 mtd14，2359296 字节，与 ZNXT/UNG00A 同格式）
#                EEPROM @0x4c000 / 光校准 @0x1c0400 / GPON SN @0x14102c（ASCII 12 字节）
# FTTR 下行    : H3C FMCS FPGA（私有，开源固件无驱动，DTS 里置 disabled）
# 内核         : 6.18    包管理：apk + 全量签名
# 组件来源     : ImmortalWrt feeds（packages / luci）+ pon_drivers / pon_userspace
#                网络栈全部走 nftables（firewall4 + kmod-nft-*），不引入 iptables / OpenWrt 官方 feed 包
# ⚠ 精简配置只写与基座的差异，必须 make defconfig 展开后才能 make
#=========================================================================

CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_LINUX_6_18=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y

#=========================================================================
# DEVICES —— 只编这一个机型
#=========================================================================
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_h3c_hm2004-du=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7581_DEVICE_h3c_hm2004-du=""

#=========================================================================
# apk 包管理（ImmortalWrt 24.10+ 默认，替代 opkg）+ 全量签名
#=========================================================================
CONFIG_USE_APK=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
CONFIG_SIGN_EACH_PACKAGE=y
CONFIG_SIGN_FIRMWARE=y

#=========================================================================
# 编译与内核选项
#=========================================================================
CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_PKG_FORTIFY_SOURCE_1=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_PKG_DT_RELR=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_REGULAR=y
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_STACKPROTECTOR=y
CONFIG_USE_SSTRIP=y
CONFIG_SSTRIP_DISCARD_TRAILING_ZEROES=y
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_MOLD=y
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y
# 说明：CONFIG_CCACHE 默认不写（保持关闭）。
# ccache 由 tools/ccache 安装到 staging_dir/host/bin，而 tools 只在
# CONFIG_CCACHE 生效时才会编入（tools/Makefile: ifneq ($(CONFIG_CCACHE)$(CONFIG_SDK),)）。
# 若工具链缓存是在「未开 ccache」时建立的，缓存命中会跳过 make tools/install，
# 于是 rules.mk 里 TARGET_CC:= ccache $(TARGET_CC) 找不到二进制 →
#   /bin/sh: 1: .../staging_dir/host/bin/ccache: not found  (Error 127)
# 需要 ccache 时请在 workflow 里把 USE_CCACHE 置 true，流程会自动补装并做好兜底。

#=========================================================================
# 1. PON 内核驱动 —— 光口链路核心，缺一个 pon 口就不通
#=========================================================================
CONFIG_PACKAGE_kmod-airoha-xpon=y                  # PON MAC：MAC/TC 层，pond 与硬件之间的通道
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y          # 光前端抽象层：BOSA 读写、校准数据、DDM 光功率/温度

#=========================================================================
# 2. PON 用户态 —— 守护进程与工具
#=========================================================================
CONFIG_PACKAGE_airoha-pond=y                       # OMCI+OAM 协议代理：ONU 注册、LOID 认证、GEM/XGEM 协商
CONFIG_PACKAGE_airoha-ponctl=y                     # 线路配置与状态：光功率、温度、偏置电流、ONU 状态
CONFIG_PACKAGE_airoha-pon-debug=y                  # 抓包与诊断：OMCI/OAM 报文抓取，日常可关

#=========================================================================
# 3. PON / IPTV 的 LuCI 界面
#=========================================================================
CONFIG_PACKAGE_luci-app-pon=y                      # PON 界面 + 板级身份编辑：SN/MAC/LOID/Vendor ID
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y               # luci-app-pon 中文包
CONFIG_PACKAGE_luci-app-iptv=y                     # IPTV 桥接配置：LAN 口 / VLAN 绑定
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y              # luci-app-iptv 中文包
CONFIG_PACKAGE_luci-app-rtp2httpd=y                # IPTV 组播转单播（RTP -> HTTP）

#=========================================================================
# 4. 网络转发 / nftables —— 全部走 nft，不引入 iptables
#=========================================================================
CONFIG_PACKAGE_kmod-nft-core=y                     # nftables 核心
CONFIG_PACKAGE_kmod-nft-nat=y                      # NAT
CONFIG_PACKAGE_kmod-nft-bridge=y                   # 桥接族
CONFIG_PACKAGE_kmod-nft-fib=y                      # FIB 查找，策略路由用
CONFIG_PACKAGE_kmod-nft-socket=y                   # socket 匹配，透明代理避免回环
CONFIG_PACKAGE_kmod-nft-tproxy=y                   # TProxy 透明代理
CONFIG_PACKAGE_kmod-nft-fullcone=y                 # 全锥形 NAT，游戏/PT 友好
CONFIG_PACKAGE_kmod-nf-nat=y                       # nf NAT 支撑
CONFIG_PACKAGE_kmod-nf-socket=y                    # nf socket 匹配
CONFIG_PACKAGE_kmod-nf-tproxy=y                    # nf TProxy
CONFIG_PACKAGE_kmod-nf-conntrack=y                 # 连接跟踪核心
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y         # conntrack netlink 接口
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y          # 桥接连接跟踪，IPTV 桥接 + 卸载需要
CONFIG_PACKAGE_kmod-nf-flow=y                      # flow offload 内核支撑
CONFIG_PACKAGE_kmod-nft-offload=y                  # nftables flow offload -> PPE 硬件转发
CONFIG_PACKAGE_kmod-nf-log=y                       # 日志
CONFIG_PACKAGE_kmod-nf-log6=y                      # IPv6 日志
CONFIG_PACKAGE_kmod-nf-reject=y                    # REJECT
CONFIG_PACKAGE_kmod-nf-reject6=y                   # IPv6 REJECT
CONFIG_PACKAGE_kmod-nfnetlink=y                    # nfnetlink
CONFIG_PACKAGE_kmod-inet-diag=y                    # socket 诊断
CONFIG_PACKAGE_kmod-netlink-diag=y                 # netlink 诊断

#=========================================================================
# 5. 隧道与拨号
#=========================================================================
CONFIG_PACKAGE_kmod-wireguard=y                    # WireGuard VPN
CONFIG_PACKAGE_kmod-tun=y                          # TUN 虚拟网卡
CONFIG_PACKAGE_kmod-udptunnel4=y                   # UDP 隧道 IPv4
CONFIG_PACKAGE_kmod-udptunnel6=y                   # UDP 隧道 IPv6
CONFIG_PACKAGE_kmod-macvlan=y                      # macvlan 虚拟网卡
CONFIG_PACKAGE_kmod-ppp=y                          # PPP
CONFIG_PACKAGE_kmod-pppoe=y                        # PPPoE
CONFIG_PACKAGE_kmod-pppox=y                        # PPP over X
CONFIG_PACKAGE_kmod-slhc=y                         # PPP 压缩
CONFIG_PACKAGE_kmod-mppe=y                         # MPPE 加密（PPTP）
CONFIG_PACKAGE_kmod-ovpn-backports=y               # OpenVPN 兼容层

#=========================================================================
# 6. LuCI 界面（ImmortalWrt 组件）
#=========================================================================
# LuCI 语言总开关（luci.mk: i18n 包 DEFAULT := LUCI_LANG_zh_Hans || (ALL&&m)）
# 该符号是 tristate 且无 default，默认 n，必须显式写 =y。
# 置 y 后，所有已选中且带 po 目录的 luci 包会自动选中 zh-cn 中文包。
CONFIG_LUCI_LANG_zh_Hans=y                         # 简体中文（zh-cn）
# CONFIG_LUCI_LANG_zh_Hant is not set              # 繁体中文
CONFIG_PACKAGE_luci=y                              # LuCI 元包
CONFIG_PACKAGE_luci-light=y                        # 轻量版
CONFIG_PACKAGE_luci-base=y                         # 基础框架
CONFIG_PACKAGE_luci-mod-admin-full=y               # 管理
CONFIG_PACKAGE_luci-mod-network=y                  # 网络
CONFIG_PACKAGE_luci-mod-status=y                   # 状态
CONFIG_PACKAGE_luci-mod-system=y                   # 系统
CONFIG_PACKAGE_luci-app-firewall=y                 # 防火墙
CONFIG_PACKAGE_luci-app-package-manager=y          # 软件包（IM 特有，配合 apk）
CONFIG_PACKAGE_luci-proto-ipv6=y                   # IPv6 协议
CONFIG_PACKAGE_luci-proto-ppp=y                    # PPP 协议
CONFIG_PACKAGE_luci-theme-argon=y                  # argon 主题
CONFIG_PACKAGE_luci-theme-bootstrap=y              # bootstrap 主题
CONFIG_PACKAGE_luci-lib-nixio_openssl=y            # nixio（openssl）
CONFIG_PACKAGE_luci-lib-uqr=y                      # uQR 二维码库
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y              # 基础中文包
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y          # 防火墙中文包
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y   # 软件包中文包

# --- 硬件状态监控（由 diy-part1.sh 拉取 / 拷贝；AN758x 专属）---
# 温度由 autocore 的 /sbin/tempinfo 提供（概览页「温度」行：CPU / WiFi / PON）
CONFIG_PACKAGE_luci-app-airoha-npu=y               # Airoha SoC 状态页：NPU 卸载/CPU 频率/Frame Engine/PPE 流表
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y        # 上者中文包（po 改名由 diy-part1.sh 处理）
CONFIG_PACKAGE_luci-app-pon-status=y               # PON 光模块卡片：收发光/温度/电流/电压（概览页系统下一格）
CONFIG_PACKAGE_luci-app-natmode=y                  # NAT 类型选择器：全锥形/受限/对称三选一（网络-NAT类型）

#=========================================================================
# 7. 基础服务 —— ImmortalWrt 默认栈
#=========================================================================
CONFIG_PACKAGE_dnsmasq-full=y                      # DNS/DHCP 全功能版（IM 默认）
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y
CONFIG_PACKAGE_firewall4=y                         # nftables 防火墙
CONFIG_PACKAGE_nftables-json=y                     # nftables JSON 接口
CONFIG_PACKAGE_netifd=y                            # 网络接口守护
CONFIG_PACKAGE_odhcp6c=y                           # IPv6 客户端
CONFIG_PACKAGE_odhcpd-ipv6only=y                   # IPv6 服务端/中继
CONFIG_PACKAGE_ppp=y                               # PPP
CONFIG_PACKAGE_ppp-mod-pppoe=y                     # PPPoE 拨号
CONFIG_PACKAGE_dropbear=y                          # SSH
CONFIG_PACKAGE_uhttpd=y                            # Web 服务器
CONFIG_PACKAGE_uhttpd-mod-ubus=y                   # uhttpd ubus 插件
CONFIG_PACKAGE_rpcd=y                              # ubus RPC 守护
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_conntrack=y                         # conntrack 命令行
CONFIG_PACKAGE_autocore=y                          # IM：系统状态信息
CONFIG_PACKAGE_shellsync=y                         # IM：shell 同步
CONFIG_PACKAGE_getrandom=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y                             # 随机数守护
CONFIG_PACKAGE_ca-bundle=y                         # CA 证书
CONFIG_PACKAGE_openwrt-keyring=y                   # 软件源公钥
CONFIG_PACKAGE_apk-openssl=y                       # apk 包管理器

#=========================================================================
# 8. 系统工具
#=========================================================================
CONFIG_PACKAGE_tcpdump=y                           # 抓包，配合 pon-debug 排查
CONFIG_PACKAGE_iperf3=y                            # 测速
CONFIG_PACKAGE_ethtool-full=y                      # 网卡查询/设置（2.5G 协商）
CONFIG_PACKAGE_ip-full=y                           # ip 命令全功能
CONFIG_PACKAGE_ip-bridge=y                         # bridge 命令
CONFIG_PACKAGE_i2c-tools=y                         # 光模块 i2c 调试
CONFIG_PACKAGE_mtd=y                               # MTD 分区读写
CONFIG_PACKAGE_nand-utils=y                        # NAND 工具
CONFIG_PACKAGE_ubi-utils=y                         # UBI 工具
CONFIG_PACKAGE_mount-utils=y                       # 挂载工具
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_cgi-io=y                            # CGI 上传下载
CONFIG_PACKAGE_uboot-envtools=y                    # 读写 u-boot 环境变量

#=========================================================================
# 9. 固件工具与签名
#=========================================================================
CONFIG_PACKAGE_fwtool=y                            # 固件签名工具
CONFIG_PACKAGE_usign=y                             # 签名工具
CONFIG_PACKAGE_fstools=y                           # 文件系统工具

#=========================================================================
# 10. 其他内核模块
#=========================================================================
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y          # GPIO 按键
CONFIG_PACKAGE_kmod-leds-gpio=y                    # GPIO LED
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-hash=y
CONFIG_PACKAGE_kmod-crypto-manager=y
CONFIG_PACKAGE_kmod-crypto-null=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-kpp=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y
CONFIG_PACKAGE_kmod-lib-crc-ccitt=y
CONFIG_PACKAGE_kmod-tcp-bbr=y                      # BBR 拥塞控制
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_libelf=y

#=========================================================================
# 11. 基础库与运行时（IM 组件）
#=========================================================================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_procd-seccomp=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-uloop=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_jansson=y
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_libblobmsg-json=y
CONFIG_PACKAGE_libgmp=y
CONFIG_PACKAGE_libiperf3=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_libjson-script=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libnetfilter-conntrack=y
CONFIG_PACKAGE_libnetfilter-cthelper=y
CONFIG_PACKAGE_libnetfilter-cttimeout=y
CONFIG_PACKAGE_libnetfilter-queue=y
CONFIG_PACKAGE_libnettle=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_libnl-tiny=y
CONFIG_PACKAGE_libpcap=y
CONFIG_PACKAGE_libpcre2=y
