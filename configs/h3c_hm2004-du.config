CONFIG_PACKAGE_libucode=y
CONFIG_PACKAGE_libudebug=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_wget-ssl=y

# --- tar / mac80211 特性开关（基座 defconfig 显式 =y，非 Kconfig 默认，必须写出）---
CONFIG_PACKAGE_TAR_POSIX_ACL=y
CONFIG_PACKAGE_TAR_XATTR=y
CONFIG_PACKAGE_TAR_BZIP2=y
CONFIG_PACKAGE_TAR_GZIP=y
CONFIG_PACKAGE_TAR_XZ=y
CONFIG_PACKAGE_TAR_ZSTD=y
CONFIG_PACKAGE_MAC80211_DEBUGFS=y                  # mac80211 debugfs
CONFIG_PACKAGE_MAC80211_MESH=y                     # 802.11s mesh 支持

#=========================================================================
# 12. 内核选项
#=========================================================================
CONFIG_KERNEL_AIO=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=y
CONFIG_KERNEL_FANOTIFY=y
CONFIG_KERNEL_IO_URING=y
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_MAGIC_SYSRQ=y
CONFIG_KERNEL_MPTCP=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_SECCOMP_FILTER=y
CONFIG_KERNEL_SWAP=y

#=========================================================================
# 13. 光器件驱动 —— 两颗互斥，本机型已按硬件选定
#=========================================================================
CONFIG_PACKAGE_kmod-airoha-en7572=y                # Airoha EN7572 光前端 ★内置
# CONFIG_PACKAGE_kmod-airoha-paged-bosa is not set # 分页 BOSA，本机型不用

#=========================================================================
# 14. 硬件卸载 —— NPU / PPE，PON 与以太网共用 ★每机型必开
#=========================================================================
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y        # EN7581 NPU(RISC-V) 固件 ★硬件卸载前提
# CONFIG_PACKAGE_airoha-an7583-npu-firmware is not set
# 卸载链路的另外三个包（kmod-nft-offload / kmod-nf-flow / kmod-nf-conntrack-bridge）
# 已在第 4 段「网络转发 / nftables」里启用，此处不重复写

#=========================================================================
# 15. WiFi —— MT7916，基座默认 =m（只出 ipk），改为 =y 内置
#=========================================================================
#     EEPROM 优先从 factory UBI 卷的 wifi_eeprom nvmem 单元读（0x4c000）；
#     下面这个固件包只是「factory 卷还没写入」时的兆底。
CONFIG_PACKAGE_kmod-mt76-core=y                    # MT76 核心
CONFIG_PACKAGE_kmod-mt76-connac=y                  # MT76 ConnAc 支持（MT7916 属此系列）
CONFIG_PACKAGE_kmod-mt7915e=y                      # MT7915/MT7916 驱动
CONFIG_PACKAGE_kmod-mt7916-firmware=y              # MT7916 固件
CONFIG_PACKAGE_kmod-mac80211=y                     # mac80211 无线栈
CONFIG_PACKAGE_kmod-cfg80211=y                     # cfg80211 配置 API
CONFIG_PACKAGE_wpad-openssl=y                      # WPA 认证（hostapd + wpa_supplicant 合一）
CONFIG_PACKAGE_hostapd-common=y                    # hostapd 公共文件/热插拔脚本
CONFIG_PACKAGE_wireless-regdb=y                    # 无线国家码与频段数据库
CONFIG_PACKAGE_iw=y                                # 无线命令行工具
CONFIG_PACKAGE_iwinfo=y                            # LuCI 无线信息依赖
CONFIG_PACKAGE_h3c-hm2004-du-mt7916-eeprom=y       # HM2004-DU 专属 MT7916 EEPROM 模板 ★本机型需要

#=========================================================================
# 16. USB 与存储 —— 本机型：1×USB2.0
#=========================================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y                 # xHCI 主机控制器
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y                 # Airoha/MediaTek 平台 xHCI（关键，缺了口不通）
CONFIG_PACKAGE_kmod-usb3=y                         # USB3.0 核心
CONFIG_PACKAGE_kmod-usb-storage=y                  # USB 存储
CONFIG_PACKAGE_kmod-usb-storage-uas=y              # UAS 协议（USB3 硬盘更快）
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y          # USB 口 LED 触发
CONFIG_PACKAGE_kmod-scsi-core=y                    # USB 硬盘依赖
CONFIG_PACKAGE_block-mount=y                       # 挂载点管理
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y

#=========================================================================
# 17. 2.5G PHY —— Airoha EN8811H
#=========================================================================
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y           # EN8811H 2.5G PHY
CONFIG_PACKAGE_airoha-en8811h-firmware=y           # EN8811H MD32 固件
# CONFIG_PACKAGE_kmod-phy-maxlinear is not set      # GPY211，本机型不用
# CONFIG_PACKAGE_kmod-phy-realtek is not set        # RTL826x，本机型不用
# CONFIG_PACKAGE_rtl826x-firmware is not set        # RTL826x 固件，本机型不用

#=========================================================================
# 18. 引导与固件 —— TF-A BL2 / BL31（AN7581）
#=========================================================================
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl2=y
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl31=y

#=========================================================================
# 19. 可选插件 —— 由 diy-part3.sh 拉取，默认全部关闭
#      取消注释即可编进固件；插件越多编译越久、镜像越大
#=========================================================================
# --- 科学上网 / 代理 ---
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
# CONFIG_PACKAGE_luci-app-passwall2=y
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-nikki=y
# CONFIG_PACKAGE_luci-app-momo=y
#
# ⚠ luci-app-daed 依赖内核 BTF，启用时还必须打开：
#     CONFIG_KERNEL_DEBUG_INFO_BTF=y
#     CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
#     CONFIG_KERNEL_BPF=y  CONFIG_KERNEL_BPF_SYSCALL=y  CONFIG_KERNEL_BPF_EVENTS=y
# 否则 eBPF 程序加载不了（基座只有 DEBUG_INFO，未开 BTF）
# CONFIG_PACKAGE_luci-app-daed=y
#
